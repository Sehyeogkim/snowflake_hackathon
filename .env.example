# Copy to .env and fill in. .env is gitignored.
# Only the backend you actually run needs credentials.

# ---- Gemini (default backend: --cortex gemini) ------------------------------
GEMINI_API_KEY=

# ---- Snowflake (--cortex snowflake) ----------------------------------------
# Cortex image inference needs a region where the multimodal models are served,
# or cross-region inference enabled on the account:
#   ALTER ACCOUNT SET CORTEX_ENABLED_CROSS_REGION = 'ANY_REGION';
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=MAVIS
SNOWFLAKE_SCHEMA=PUBLIC
MAVIS_STAGE=MAVIS_FRAMES

# ---- Model tiers ------------------------------------------------------------
# Both tiers must accept image input. These names are interpreted by whichever
# backend is selected, so set them to match it — Gemini model ids for
# --cortex gemini, Cortex model ids for --cortex snowflake.
#
# Gemini defaults (verified working 2026-08-07):
#   MAVIS_CHEAP_MODEL=gemini-2.5-flash-lite
#   MAVIS_STRONG_MODEL=gemini-3.1-pro-preview
# Snowflake defaults:
#   MAVIS_CHEAP_MODEL=claude-haiku-4-5
#   MAVIS_STRONG_MODEL=claude-sonnet-5
MAVIS_CHEAP_MODEL=
MAVIS_STRONG_MODEL=

# ---- EverOS ----------------------------------------------------------------
EVEROS_BASE_URL=
EVEROS_API_KEY=
