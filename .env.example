# Snowflake: password auth (quickest for a hackathon account)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=MAVIS_APP_ROLE
SNOWFLAKE_WAREHOUSE=MAVIS_WH
SNOWFLAKE_DATABASE=MAVIS
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_IMAGE_STAGE=MAVIS_IMAGES

# Optional alternatives supported by snowflake-connector-python.
SNOWFLAKE_AUTHENTICATOR=snowflake
SNOWFLAKE_PRIVATE_KEY_FILE=

# EverOS / EverMemOS Cloud. Set the URL/path values to the workshop tenant docs.
EVEROS_API_KEY=
EVER_OS_BASE_URL=https://api.evermind.ai
EVEROS_USER_ID=mavis-hackathon
EVEROS_AGENT_ID=mavis-agent-v1
EVEROS_APP_ID=mavis
EVEROS_PROJECT_ID=factory-safety-seed-v1

# Reproducibility
MAVIS_RUN_SEED=42

# Google Gemini Developer API
GEMINI_API_KEY=
